# Copy to .env for local dev. Set the real values in Netlify env vars for production.
PUBLIC_SITE_URL=https://fore-grant.netlify.app

# Google Sheets integration — service account credentials
# Never commit real values. Set these as Netlify environment variables for
# production, and in a local .env (gitignored) for dev.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

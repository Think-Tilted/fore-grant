---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About Grant — Teeing Off Fore Grant">
  <section class="py-16 lg:py-24">
    <p class="text-center flyer-caps text-lg text-fairway-light">Meet Grant</p>
    <h1 class="mt-1 text-center font-display text-4xl sm:text-5xl font-bold text-fairway">
      Join the Fight
    </h1>
    <div class="mt-6 flex justify-center">
      <span class="ribbon-banner text-sm font-display font-semibold tracking-wide">
        #GrantsTALLBattle
      </span>
    </div>


    <div class="mt-12 max-w-2xl mx-auto space-y-6 text-lg text-ink-soft">
      <p>
        Grant is a strong and inspiring 10-year-old who is bravely battling leukemia. This
        tournament is more than a game — it's a way to come together and rally around Grant and
        his family.
      </p>
      <p>
        By becoming a sponsor, a player, or simply spreading the word, you are helping provide
        hope, strength, and support when it's needed most. <strong class="text-ink">His fight is our fight.</strong>
      </p>
    </div>

    <div class="mt-14 rounded-xl bg-paper-dim px-6 py-8 sm:px-10 max-w-2xl mx-auto text-center">
      <h2 class="font-display text-2xl font-bold text-fairway">Teeing Off Fore Grant</h2>
      <p class="mt-3 text-ink-soft">
        Friday, November 6th, 2026 · 9:00 AM Shotgun Start
      </p>
      <p class="mt-1 font-medium text-ink">
        San Vicente Golf Course, 24157 San Vicente Rd, Ramona, CA 92065
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-md bg-ribbon px-6 py-2.5 font-display font-semibold text-white transition hover:bg-ribbon-dark"
      >
        Register as a Sponsor
      </a>

    </div>

    <p class="mt-12 text-center font-display text-xl text-fairway">
      Together, we can drive out leukemia—one swing at a time.
    </p>
  </section>
</BaseLayout>

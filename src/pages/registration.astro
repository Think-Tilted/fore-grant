---
/**
 * Registration — per LAYOUT-SPEC.md "Registration — 1440×3951 · mobile 390×4566".
 *
 * Page header: col · pad 80/64/48/64 · gap 24, h1 display/lg on text/brand.
 * Packages: col · pad 0/64/80/64 · gap 64, each bucket col · gap 20.
 * Other Ways: same callout as Home.
 *
 * Tier data driven from src/data/tiers.ts (single source of truth).
 * Foursome Entry links to /registration/foursome; all sponsor tiers
 * link to /registration/sponsor?tier={id}.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TierRow from "../components/TierRow.astro";
import Button from "../components/Button.astro";
import { buckets } from "../data/tiers";
---

<BaseLayout title="Registration — Teeing Off Fore Grant" navVariant="subpage">
  <!-- Page header -->
  <section class="reg-hero">
    <h1>Sponsorship Opportunities</h1>
  </section>

  <!-- Tier buckets -->
  <section class="reg-packages">
    {buckets.map((bucket) => (
      <div class="reg-bucket">
        <div class="bucket-heading">
          <h2>{bucket.name}</h2>
          <div class="bucket-rule" aria-hidden="true"></div>
        </div>
        {bucket.tiers.map((tier) => (
          <TierRow
            tier={tier}
            registerHref={
              tier.id === "foursome-entry-group-package"
                ? "/registration/foursome"
                : `/registration/sponsor?tier=${tier.id}`
            }
          />
        ))}
      </div>
    ))}
  </section>

  <!-- Other Ways -->
  <section class="other-ways">
    <div class="other-ways-inner">
      <div class="callout">
        <h2>Other Ways to Support Us!</h2>
        <p>
          If a sponsorship isn't possible, please consider donating products, services, or gift
          certificates for our golf goodie bags, raffle, or silent auction. If you'd like to
          contribute to the event, please contact Jessica. Otherwise, please consider donating to
          Grant's GoFundMe. This event wouldn't be possible without the generous support of our
          donors — your contribution makes a huge difference!
        </p>
        <Button href="https://www.gofundme.com/f/support-grant-through-his-tall-battle" variant="primary" size="medium">
          Give to Grant's GoFundMe
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page header: col · pad 80/64/48/64 */
  .reg-hero {
    background-color: var(--color-bg-page);
    padding: var(--spacing-20) var(--spacing-16) var(--spacing-12);
    text-align: center;
  }
  .reg-hero h1 {
    font-family: var(--font-heading);
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    letter-spacing: var(--text-display-lg--letter-spacing);
    font-weight: 700;
    color: var(--color-text-brand);
  }

  /* Packages: col · pad 0/64/80/64 · gap 64 */
  .reg-packages {
    background-color: var(--color-bg-page);
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--spacing-16) var(--spacing-20);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  /* Bucket: col · gap 20 */
  .reg-bucket {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }
  .bucket-heading {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-1);
  }
  .bucket-heading h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-bucket);
    line-height: var(--text-heading-bucket--line-height);
    font-weight: 700;
    color: var(--color-text-brand);
    white-space: nowrap;
  }
  .bucket-rule {
    flex: 1; height: 2px;
    background-color: var(--color-accent-default);
    border-radius: 1px;
  }

  /* Other Ways */
  .other-ways {
    background-color: var(--color-bg-page);
    padding: var(--spacing-12) var(--spacing-16);
  }
  .other-ways-inner { max-width: 1312px; margin: 0 auto; }
  .callout {
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-lg);
    padding: var(--spacing-12);
    display: flex; flex-direction: column; align-items: center;
    gap: var(--spacing-5); text-align: center;
  }
  .callout h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-bucket);
    line-height: var(--text-heading-bucket--line-height);
    font-weight: 700; color: var(--color-text-accent);
  }
  .callout p {
    font-family: var(--font-body);
    font-size: var(--text-body-md); line-height: var(--text-body-md--line-height);
    color: var(--color-text-primary); max-width: 680px;
  }

  @media (max-width: 767px) {
    .reg-hero { padding: var(--spacing-10) var(--spacing-5) var(--spacing-6); }
    .reg-hero h1 {
      font-size: var(--text-mobile-display-lg);
      line-height: var(--text-mobile-display-lg--line-height);
    }
    .reg-packages { padding: 0 var(--spacing-5) var(--spacing-10); gap: var(--spacing-5); }
    .other-ways { padding: var(--spacing-10) var(--spacing-5); }
    .bucket-heading h2 {
      font-size: var(--text-mobile-heading-bucket);
      line-height: var(--text-mobile-heading-bucket--line-height);
    }
  }
</style>

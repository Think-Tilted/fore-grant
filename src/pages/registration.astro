---
/**
 * Registration — Sponsorship Opportunities page, built from the Figma
 * "Registration" frame. Sections top to bottom:
 *   ArgyleBand + Nav (via BaseLayout) >
 *   Page heading "Sponsorship Opportunities" >
 *   Premium Sponsorship (1 tier) >
 *   Meal Sponsorships (2 tiers) >
 *   Hole Sponsorships (4 tiers) >
 *   Golf Entry (1 tier) >
 *   Other Ways to Support Us (callout card) >
 *   Footer (via BaseLayout)
 *
 * Layout deviation from SponsorTierCard component: the Figma registration
 * page uses a wide horizontal card layout (full-width row: benefits left,
 * price + CTA right) rather than the narrow vertical card used on the
 * sponsor-tier component page. The horizontal layout is implemented here
 * with local CSS rather than extending the component, since the component
 * is designed for a different context (narrow column grid). This is
 * documented here per the project's deviation rule.
 *
 * Availability counts are hardcoded from the screenshots (design source of
 * truth). These will need to be wired to live data when the backend is ready.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/Badge.astro";
import Button from "../components/Button.astro";

interface Tier {
  name: string;
  badge: string;
  badgeTone: "neutral" | "limited" | "soldout";
  price: string;
  sub: string;
  benefits: string[];
  href: string;
}


  },
];

const holeTiers: Tier[] = [
  {
    name: "Premium Adopt-A-Hole — Contest Holes",
    badge: "2 left",
    badgeTone: "neutral",
    price: "$1,750",
    sub: "Includes 4 golfers",
    benefits: [
      "Drive Out Leukemia (Longest Drive) or Swing for Strength (Closest to the Pin)",

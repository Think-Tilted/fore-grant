---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Teeing Off Fore Grant">
  <section class="py-16 lg:py-24">
    <h1 class="text-center font-display text-4xl sm:text-5xl font-bold text-fairway">
      Questions?
    </h1>
    <p class="mt-4 text-center text-ink-soft max-w-xl mx-auto">
      Interested in sponsoring, playing, or donating? Reach out — we'd love to hear from you.
    </p>

    <div class="mt-12 max-w-md mx-auto rounded-xl bg-paper-dim px-8 py-10 text-center space-y-6">
      <div>
        <p class="text-xs uppercase tracking-wide text-ink-soft">Email</p>
        <a
          href="mailto:grantstallbattle@gmail.com"
          class="mt-1 block font-display text-xl font-semibold text-fairway hover:text-ribbon"
        >
          grantstallbattle@gmail.com
        </a>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wide text-ink-soft">Phone</p>
        <a
          href="tel:6193447687"
          class="mt-1 block font-display text-xl font-semibold text-fairway hover:text-ribbon"
        >
          Jessica: 619-344-7687
        </a>
      </div>
    </div>

    <div class="mt-14 text-center">
      <span class="ribbon-banner text-sm font-display font-semibold tracking-wide">
        #GrantsTALLBattle
      </span>

    </div>
  </section>
</BaseLayout>

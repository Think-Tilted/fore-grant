---
/**
 * Contact page — ported from Figma "Contact" frame.
 *
 * Figma source: centered layout, page title "Contact" in display/h1,
 * then an "EVENT DIRECTOR" eyebrow label, director name in display/h2,
 * then three contact lines (email, call/text, Instagram) where the
 * label portion is accent-display orange (--color-accent-display) and
 * the value is body text. No form on this page — forms live on /registration.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Teeing Off Fore Grant">
  <section class="contact-section">
    <h1 class="contact-title">Contact</h1>

    <div class="contact-card">
      <p class="contact-eyebrow">EVENT DIRECTOR</p>
      <h2 class="contact-name">Jessica Carlson-Petersen</h2>

      <ul class="contact-lines">
        <li>
          <span class="contact-label">email:</span>
          <a href="mailto:grantstallbattle@gmail.com" class="contact-value contact-link">
            grantstallbattle@gmail.com
          </a>
        </li>
        <li>
          <span class="contact-label">call/text:</span>
          <a href="tel:6193447687" class="contact-value contact-link">
            619-344-7687
          </a>
        </li>
        <li>
          <span class="contact-label">Follow on Instagram</span>
          <a
            href="https://www.instagram.com/GrantsTALLBattle"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-value contact-link"
          >
            @GrantsTALLBattle
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  @layer components {
    /* Figma: section has generous vertical padding, content centered */
    .contact-section {
      padding: var(--spacing-16) var(--spacing-6) var(--spacing-20);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Figma: "Contact" h1 — display font, large, brand green */
    .contact-title {
      font-family: var(--font-display);
      font-size: var(--text-5xl);
      font-weight: 700;
      color: var(--color-text-brand);
      text-align: center;
      margin: 0 0 var(--spacing-10);
    }

    /* Card: centered, no background — Figma shows plain centered text block */
    .contact-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--spacing-2);
      text-align: center;
    }

    /* Figma: "EVENT DIRECTOR" — small caps eyebrow, letter-spaced, muted */
    .contact-eyebrow {
      font-family: var(--font-display);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      margin: 0;
    }

    /* Figma: director name — display/h2, brand green, bold */
    .contact-name {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      font-weight: 700;
      color: var(--color-text-brand);
      margin: var(--spacing-1) 0 var(--spacing-6);
    }

    /* Contact lines list */
    .contact-lines {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-3);
    }

    .contact-lines li {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: var(--spacing-2);
      flex-wrap: wrap;
    }

    /* Figma: label portion is accent-display orange, bold italic display font */
    .contact-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-style: italic;
      color: var(--color-accent-display);
    }

    /* Figma: value portion is body text color */
    .contact-value {
      font-family: var(--font-body);
      color: var(--color-text-primary);
    }

    .contact-link {
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .contact-link:hover {
      color: var(--color-text-brand);
    }
  }
</style>

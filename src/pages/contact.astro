---
/**
 * Contact — per LAYOUT-SPEC.md "Contact — 1440×1128 · mobile 390×1079".
 *
 * Page header: col · pad 80/0/40/0 · gap 24 · center, h1 display/lg.
 * Contact details: col · pad 0/64/96/64 · gap 32 — director block gap 12,
 *   details gap 8. Role = mono/caption, name = display/price.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Teeing Off Fore Grant">
  <!-- Page header -->
  <section class="contact-header">
    <h1>Contact</h1>
  </section>

  <!-- Contact details -->
  <section class="contact-details">
    <div class="contact-director">
      <p class="contact-role">EVENT DIRECTOR</p>
      <h2 class="contact-name">Jessica Carlson-Petersen</h2>
    </div>

    <ul class="contact-lines">
      <li>
        <span class="contact-label">email:</span>
        <a href="mailto:grantstallbattle@gmail.com" class="contact-value">
          grantstallbattle@gmail.com
        </a>
      </li>
      <li>
        <span class="contact-label">call/text:</span>
        <a href="tel:6193447687" class="contact-value">
          619-344-7687
        </a>
      </li>
      <li>
        <span class="contact-label">Follow on Instagram</span>
        <a
          href="https://www.instagram.com/GrantsTALLBattle"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-value"
        >
          @GrantsTALLBattle
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  /* Page header: col · pad 80/0/40/0 · gap 24 · center */
  .contact-header {
    padding: var(--spacing-20) 0 var(--spacing-10);
    text-align: center;
  }
  .contact-header h1 {
    font-family: var(--font-heading);
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    letter-spacing: var(--text-display-lg--letter-spacing);
    font-weight: 700;
    color: var(--color-text-brand);
  }

  /* Contact details: col · pad 0/64/96/64 · gap 32 */
  .contact-details {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--spacing-16) var(--spacing-24);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-8);
    text-align: center;
  }

  /* Director block: gap 12 */
  .contact-director {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3);
  }
  /* Role = mono/caption */
  .contact-role {
    font-family: var(--font-mono);
    font-size: var(--text-mono-caption);
    line-height: var(--text-mono-caption--line-height);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    margin: 0;
  }
  /* Name = display/price */
  .contact-name {
    font-family: var(--font-heading);
    font-size: var(--text-display-price);
    line-height: var(--text-display-price--line-height);
    font-weight: 700;
    color: var(--color-text-brand);
  }

  /* Details: gap 8 */
  .contact-lines {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  .contact-lines li {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }
  .contact-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    color: var(--color-accent-display);
  }
  .contact-value {
    font-family: var(--font-body);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--motion-duration-hover) var(--motion-ease);
  }
  .contact-value:hover {
    color: var(--color-text-brand);
  }

  @media (max-width: 767px) {
    .contact-header {
      padding: var(--spacing-8) 0 var(--spacing-4);
    }
    .contact-header h1 {
      font-size: var(--text-mobile-display-lg);
      line-height: var(--text-mobile-display-lg--line-height);
    }
    .contact-details {
      padding: 0 var(--spacing-5) var(--spacing-10);
      gap: var(--spacing-4);
    }
    .contact-name {
      font-size: var(--text-mobile-display-price);
      line-height: var(--text-mobile-display-price--line-height);
    }
  }
</style>

---
/**
 * Home — per LAYOUT-SPEC.md "Home — 1440×4077 · mobile 390×4120".
 *
 * Sections top to bottom:
 *   Argyle band (88px, via BaseLayout) → hero nav (via BaseLayout) →
 *   Meet Grant → Sponsor CTA → Sponsors ticker (HIDDEN — V2) →
 *   Last year (carousel) → Other Ways → Find Us → Footer (via BaseLayout)
 *
 * Grant is 11, not 10 (CLAUDE.md copy correction).
 * Sponsor ticker ships hidden per Kyle's direction (HANDOFF.md §10).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Carousel from "../components/Carousel.astro";
import Logo from "../components/Logo.astro";

const carouselImages = Array.from({ length: 27 }, (_, i) => {
  const n = i < 27 ? String(i + 1).padStart(2, "0") : "29";
  return {
    src: `/photos/carousel/tourney-${n}.jpg`,
    alt: `Photo from last year's Fore Grant tournament`,
  };
});
// tourney-28 was pulled; numbering skips it
carouselImages.push({
  src: "/photos/carousel/tourney-29.jpg",
  alt: "Photo from last year's Fore Grant tournament",
});
---

<BaseLayout title="Teeing Off Fore Grant — Charity Golf Tournament" navVariant="home">

  <!-- Mobile hero — only shown on mobile (<768).
       col · pad 44/24/40/24 · gap 18 · bg bg/inverse.
       Background photo deferred — using bg/inverse fill for now.
       Desktop uses the full hero nav rendered inside Nav.astro (nav-desktop). -->
  <div class="home-hero-mobile">
    <a href="/" class="home-hero-logo" aria-label="Teeing Off Fore Grant — home">
      <Logo variant="badge" />
    </a>
    <p class="home-hero-eyebrow">The 2nd Annual</p>
    <h1 class="home-hero-date">Friday, November 6, 2026</h1>
    <p class="home-hero-venue">San Vicente Golf Course · Ramona</p>
    <p class="home-hero-time">9:00 AM shotgun start</p>
    <Button href="/registration" size="large" variant="primary" class="home-hero-cta">
      Register Today
    </Button>
  </div>

  <!-- Meet Grant: col · pad 80/64/80/64 · gap 40 → row 1312×470, gap 48
       Mobile: photo moves inside the card, top-left beside the heading. -->
  <section class="meet-grant">
    <div class="meet-grant-row">
      <!-- Desktop only: standalone photo left of the card -->
      <img class="meet-grant-photo" src="/photos/meet-grant.png" alt="Grant, smiling" />
      <div class="meet-grant-story">
        <div class="meet-grant-inner">
          <!-- Mobile only: photo + heading in a top row inside the card -->
          <div class="meet-grant-card-top">
            <img class="meet-grant-card-photo" src="/photos/meet-grant.png" alt="Grant, smiling" />
            <h2 class="meet-grant-card-heading">Meet Grant: Join the Fight</h2>
          </div>
          <div class="meet-grant-text">
            <!-- Desktop only heading (hidden on mobile) -->
            <h2 class="meet-grant-desktop-heading">Meet Grant: Join the Fight</h2>
            <p>
              Grant is a strong and inspiring 11-year-old who is bravely battling T Cell Acute Lymphoblastic Leukemia (T-ALL). This
              tournament is more than a game — it's a way to come together and rally around Grant and
              his family.
            </p>
            <p>
              By becoming a sponsor, a player, or simply spreading the word, you are helping provide
              hope, strength, and support when it's needed most. His fight is our fight.
            </p>
          </div>
          <img class="his-fight-logo" src="/logos/his-fight-is-our-fight.png" alt="His Fight Is Our Fight" />
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsor CTA: col · pad 48/64/58/64 → card bg/inverse, pad 48, gap 24 -->
  <section class="sponsor-cta">
    <div class="cta-card">
      <div class="golf-balls" aria-hidden="true">
        <img src="/icons/icon-golf-ball.svg" alt="" width="57" height="54" />
        <img src="/icons/icon-golf-ball.svg" alt="" width="57" height="54" />
        <img src="/icons/icon-golf-ball.svg" alt="" width="57" height="54" />
      </div>
      <h2>Ready to play Fore Grant?</h2>
      <p>
        Become a sponsor or play as a foursome — every registration helps drive out leukemia,
        one swing at a time.
      </p>
      <Button href="/registration" size="large">Register Today</Button>
    </div>
  </section>

  <!-- Sponsors ticker: HIDDEN — V2, do not build -->

  <!-- Last year: col · pad 80/64/80/64 · gap 32 · bg bg/panel -->
  <section class="last-year">
    <h2>Last year was a hit!</h2>
    <Carousel images={carouselImages} />
  </section>


  <!-- Other Ways: col · pad 64/64/64/64 · gap 32 → callout bg/panel, pad 48, gap 20 -->
  <section class="other-ways">
    <div class="callout">
      <h2>Other Ways to Support Us!</h2>
      <p>
        If a sponsorship isn't possible, please consider donating products, services, or gift
        certificates for our golf goodie bags, raffle, or silent auction. This event wouldn't be
        possible without the generous support of our donors. Your contribution makes a huge
        difference!
      </p>
      <Button href="https://www.gofundme.com/f/support-grant-through-his-tall-battle" variant="primary" size="large">
        Give to Grant's GoFundMe
      </Button>
    </div>
  </section>

  <!-- Find Us: col · pad 41/64/24/64 · gap 23 -->
  <section class="find-us">
    <h2>Find Us at San Vicente Golf Course</h2>
    <p class="find-us-addr">24157 San Vicente Rd, Ramona, CA 92065</p>
    <div class="find-us-container">
      <div class="find-us__map">
        <iframe
          title="Map to San Vicente Resort, Ramona, California"
          src="https://www.google.com/maps?q=San+Vicente+Resort,+24157+San+Vicente+Rd,+Ramona,+CA+92065&z=15&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
    <img class="resort-logo" src="/logos/san-vicente-resort.png" alt="San Vicente Golf Resort logo" />
  </section>
</BaseLayout>


<style>
  /* ---- Mobile home hero: hidden on desktop, shown on mobile only ---- */
  .home-hero-mobile {
    display: none;
  }

  /* ---- Meet Grant: col · pad 80/64/80/64 · gap 40 ---- */
  /* Mobile card elements hidden on desktop */
  .meet-grant-card-top { display: none; }
  .meet-grant-card-photo { display: none; }
  .meet-grant-card-heading { display: none; }

  .meet-grant {
    background-color: var(--color-bg-page);
    padding: var(--spacing-20) var(--spacing-16);
  }
  /* LAYOUT-SPEC: row is 1312×470 — a fixed track, not sized by content.
     `height` on a grid CONTAINER does not constrain an implicit auto row —
     the row still grows to fit its tallest child and overflows past the
     stated height. grid-template-rows fixes the actual row track, and
     overflow: hidden on the story card stops its content (esp. the tall
     portrait His Fight logo) from forcing the card past that track. */
  .meet-grant-row {
    max-width: 1312px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 3fr;
    grid-template-rows: 470px;
    gap: var(--spacing-12);
  }
  .meet-grant-photo {
    width: 100%; height: 100%;
    object-fit: cover;
    /* Default center crop was clipping the top of Grant's head — shift
       the visible window down slightly so his face/head stay in frame. */
    object-position: center 20%;
    border-radius: var(--radius-lg);
  }
  .meet-grant-story {
    border: 2px solid var(--color-brand-orange);
    border-radius: var(--radius-lg);
    padding: var(--spacing-10);
    height: 100%;
    overflow: hidden;
  }
  .meet-grant-inner {
    display: flex; align-items: center; gap: var(--spacing-6);
    height: 100%;
  }
  .meet-grant-text {
    display: flex; flex-direction: column; gap: var(--spacing-6); flex: 1;
    min-width: 0;
  }
  .meet-grant-story h2,
  .meet-grant-desktop-heading {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    font-weight: 700;
    color: var(--color-brand-orange);
  }
  .meet-grant-story p {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    color: var(--color-text-primary);
  }
  /* Constrained by HEIGHT, not width — the logo is portrait (1200×1734).
     Sizing it by max-width alone renders it ~318px tall at 220px wide,
     which overflows the 470px card once combined with the heading,
     body copy, and 40px padding on all sides. Capping height keeps it
     proportional and lets it shrink to whatever room the text leaves. */
  .his-fight-logo {
    max-height: 100%;
    max-width: 200px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  /* ---- Sponsor CTA ---- */
  .sponsor-cta {
    background-color: var(--color-bg-page);
    padding: var(--spacing-12) var(--spacing-16) 58px;
  }
  .cta-card {
    max-width: 1312px; margin: 0 auto;
    background-color: var(--color-bg-inverse);
    border-radius: var(--radius-xl);
    padding: var(--spacing-12);
    display: flex; flex-direction: column; align-items: center;
    gap: var(--spacing-6); text-align: center;
  }
  .golf-balls { display: flex; align-items: center; gap: var(--spacing-5); }
  .cta-card h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    font-weight: 700; color: var(--color-bg-page);
  }
  .cta-card p {
    font-family: var(--font-body);
    font-size: var(--text-heading-h3); line-height: 1.6;
    color: var(--color-bg-panel); max-width: 640px;
  }

  /* ---- Last year: bg/panel ---- */
  .last-year {
    background-color: var(--color-bg-panel);
    padding: var(--spacing-20) var(--spacing-16);
    display: flex; flex-direction: column; align-items: center;
    gap: var(--spacing-8);
  }
  .last-year h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    font-weight: 700; color: var(--color-bg-inverse);
  }
  .last-year :global(.carousel) { max-width: 1312px; width: 100%; }

  /* ---- Other Ways ---- */
  .other-ways {
    background-color: var(--color-bg-page);
    padding: var(--spacing-16);
  }
  .callout {
    max-width: 1312px; margin: 0 auto;
    background-color: var(--color-bg-panel);
    border: 2px solid var(--color-argyle-dot);
    border-radius: var(--radius-lg);
    padding: var(--spacing-12);
    display: flex; flex-direction: column; align-items: center;
    gap: var(--spacing-5); text-align: center;
  }
  .callout h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    font-weight: 700; color: var(--color-text-accent);
  }
  .callout p {
    font-family: var(--font-body);
    font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);
    color: var(--color-text-primary); max-width: 720px;
  }

  /* ---- Find Us ---- */
  .find-us {
    background-color: var(--color-bg-page);
    padding: 41px var(--spacing-16) var(--spacing-6);
    display: flex; flex-direction: column; align-items: center;
    gap: 23px; text-align: center;
  }
  .find-us h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    font-weight: 700; color: var(--color-bg-inverse);
  }
  .find-us-addr {
    font-family: var(--font-body);
    font-size: var(--text-body-lg); line-height: 1.5;
    color: var(--color-text-secondary);
  }
  /* Match the site's 1312 container — .find-us__map's own width:100%
     otherwise stretches to the section's full padded width. */
  .find-us-container {
    width: 100%;
    max-width: 1312px;
  }
  .resort-logo {
    width: 170px; height: 110px;
    object-fit: contain; border-radius: var(--radius-md);
    margin-top: var(--spacing-4);
  }

  /* ---- Mobile ---- */
  @media (max-width: 767px) {
    /* Mobile hero: col · pad 44/24/40/24 · gap 18 · bg bg/inverse
       tourney-05.jpg as background, darkened with a green overlay so text
       stays readable. bg-inverse is the fallback while the image loads. */
    .home-hero-mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 44px var(--spacing-6) var(--spacing-10);
      gap: 18px;
      background-color: var(--color-bg-inverse);
      background-image:
        linear-gradient(rgba(49, 83, 45, 0.72), rgba(49, 83, 45, 0.72)),
        url("/photos/carousel/tourney-05.jpg");
      background-size: cover;
      background-position: center;
    }
    .home-hero-logo {
      width: 200px;
      display: block;
    }
    /* "THE 2ND ANNUAL" — mono/caption treatment, spaced caps */
    .home-hero-eyebrow {
      font-family: var(--font-mono);
      font-size: var(--text-mono-caption);
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-text-inverse);
      margin: 0;
    }
    /* "Friday, November 6, 2026" — single line, tan/cream */
    .home-hero-date {
      font-family: var(--font-heading);
      font-size: var(--text-mobile-heading-section);
      line-height: var(--text-mobile-heading-section--line-height);
      font-weight: 700;
      color: var(--color-text-inverse);
      white-space: nowrap;
      margin: 0;
    }
    /* Venue and time — body/md on text/inverse */
    .home-hero-venue,
    .home-hero-time {
      font-family: var(--font-body);
      font-size: var(--text-body-md);
      line-height: var(--text-body-md--line-height);
      color: var(--color-text-inverse);
      margin: 0;
    }
    /* CTA full width */
    :global(.home-hero-cta) {
      width: 100%;
      justify-content: center;
      margin-top: var(--spacing-2);
    }

    /* Mobile Meet Grant: col · pad 32/20/32/20 · gap 20
       The photo moves inside the card — top row is photo+heading side by side,
       body text below full-width, His Fight logo centered at bottom. */
    .meet-grant { padding: var(--spacing-8) var(--spacing-5); }

    /* Grid collapses to 1 col but photo is now inside the card, so the
       row is just the single story card — hide the standalone photo. */
    .meet-grant-row {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 0;
      height: auto;
    }
    .meet-grant-photo { display: none; }

    /* Card: reset height/overflow from desktop, keep border + radius */
    .meet-grant-story {
      height: auto;
      overflow: visible;
      padding: var(--spacing-5);
    }

    /* Inner: column — photo+heading row on top, text below, logo at bottom */
    .meet-grant-inner {
      flex-direction: column;
      height: auto;
      gap: var(--spacing-4);
    }

    /* Top row: small photo + heading side by side */
    .meet-grant-inner::before {
      display: none; /* no pseudo elements needed */
    }
    .meet-grant-text { gap: var(--spacing-4); }

    /* Mobile card top: photo + heading side by side */
    .meet-grant-card-top {
      display: flex;
      align-items: flex-start;
      gap: var(--spacing-4);
    }
    .meet-grant-card-photo {
      display: block;
      width: 140px;
      height: 140px;
      object-fit: cover;
      object-position: center 20%;
      border-radius: var(--radius-md);
      flex-shrink: 0;
    }
    .meet-grant-card-heading {
      display: block;
      font-family: var(--font-heading);
      font-size: var(--text-mobile-heading-section);
      line-height: var(--text-mobile-heading-section--line-height);
      font-weight: 700;
      color: var(--color-brand-orange);
    }
    /* Desktop heading hidden on mobile */
    .meet-grant-desktop-heading { display: none; }

    /* His Fight logo: show on mobile, centered */
    .his-fight-logo {
      display: block;
      max-width: 160px;
      max-height: none;
      width: auto;
      margin: var(--spacing-2) auto 0;
    }

    .cta-card h2,
    .last-year h2,
    .callout h2,
    .find-us h2 {
      font-size: var(--text-mobile-heading-section);
      line-height: var(--text-mobile-heading-section--line-height);
    }
    .sponsor-cta { padding: 28px var(--spacing-5); }
    .last-year { padding: var(--spacing-10) var(--spacing-5); }
    .other-ways { padding: var(--spacing-10) var(--spacing-5); }
    .find-us { padding: 28px var(--spacing-5) var(--spacing-6); }
    /* Callout + CTA buttons: allow height to grow with wrapped text on mobile */
    .callout :global(.btn),
    .cta-card :global(.btn) {
      height: auto;
      padding-top: var(--spacing-3);
      padding-bottom: var(--spacing-3);
      white-space: normal;
      width: 100%;
      justify-content: center;
    }
    .meet-grant-story h2,
    .cta-card h2,
    .last-year h2,
    .callout h2,
    .find-us h2 {
      font-size: var(--text-mobile-heading-section);
      line-height: var(--text-mobile-heading-section--line-height);
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const tiers = [
  {
    name: "Orange Ribbon Champion",
    price: "$5,000+",
    max: "Max of 2",
    featured: true,
    perks: [
      "Premier logo placement on event signage, flyer, and communication",
      "Recognition in all social media posts & cart name tags",
      "Company or brand logo displayed on signage at designated hole",
      "Complimentary entry for 2 foursomes (8 players total); and 10 total dinner tickets",
      "Speaking opportunity at awards ceremony",
      "Includes Adopt-a-Hole at premier holes",
      "Promotional items in every golfer's goodie bag",
    ],
  },
  {
    name: "Premium Adopt-A-Hole (Contest Holes)",
    price: "$1,750",
    max: "Max 2",
    perks: [
      "Drive Out Leukemia Sponsor (Longest Drive) or Swing for Strength Sponsor (Closest to the Pin)",
      "Recognition in all social media posts",
      "Company or brand logo displayed on signage at designated hole",
      "Hand out food, drinks, or giveaways at a hole",
      "Complimentary entry for 1 foursome (4 players total)",
    ],
  },
  {
    name: "Adopt-a-Hole Sponsor",
    price: "$1,500",
    max: "Max 9",
    perks: [
      "Recognition in all social media posts",
      "Company or brand logo displayed on signage at designated hole",
      "Hand out food, drinks, or giveaways at a hole",
      "Complimentary entry for 1 foursome (4 players total)",
    ],
  },
  {
    name: '"19th Hole" Lunch Sponsor',
    price: "$3,500",
    max: "Max of 2",
    perks: [
      "Premier recognition as the sponsor of the tournament dinner",
      "Logo featured on dinner signage",
      "Acknowledgment during awards and dinner program",
      "Complimentary entry for 2 foursomes (8 players total)",
    ],
  },
  {
    name: '"Pre-Round Fuel" Breakfast Sponsor',
    price: "$2,000",
    max: "Max of 2",
    perks: [
      "Premier recognition as the sponsor of the tournament lunch",
      "Logo featured on lunch signage",
      "Acknowledgment during awards and dinner program",
      "Complimentary entry for 1 foursome (4 players total)",
    ],
  },
  {
    name: "Putting for a Cure Sponsor",
    price: "$1,000",
    max: "Max 1",
    perks: [
      "Host putting contest",
      "Company or brand logo displayed on signage at putting green",
      "Recognition in event program and website",
      "Complimentary entry for 1 foursome (4 players total)",
    ],
  },
  {
    name: "Tee Sign Sponsor",
    price: "$250",
    max: "Max 5",
    perks: [
      "Your name or company logo displayed on a tee sign at a hole",
      "Promotional items in every golfer's goodie bag",
    ],
  },
  {
    name: "Foursome Entry",
    price: "$600",
    max: "Group Package",
    perks: ["18 holes for four players", "Cart rental", "Lunch & dinner", "Player swag bags"],
  },
];
---

<BaseLayout title="Teeing Off Fore Grant — Charity Golf Tournament">
  <!-- Hero — laid out like the flyer's masthead -->
  <section class="pt-12 pb-16 lg:pt-16 lg:pb-20 text-center">
    <!-- TEEING ⟨ribbon⟩ OFF -->
    <div class="flex items-center justify-center gap-3 sm:gap-4 -translate-x-12 sm:-translate-x-15">



      <span class="flyer-caps text-2xl sm:text-3xl text-fairway">Teeing</span>
      <svg viewBox="0 0 44 60" class="h-12 sm:h-14 w-auto shrink-0" aria-hidden="true">
        <!-- awareness ribbon -->
        <path
          d="M22 6 C14 -3, 2 4, 7 16 C10 23, 16 27, 20 34 L14 48 L20 52 L22 44 L24 52 L30 48 L24 34 C28 27, 34 23, 37 16 C42 4, 30 -3, 22 6 Z"
          fill="#e05e2b"
        />
        <path
          d="M22 10 C18 5, 11 8, 13 15 C15 20, 19 23, 22 28 C25 23, 29 20, 31 15 C33 8, 26 5, 22 10 Z"
          fill="#f2efe4"
        />
      </svg>
      <span class="flyer-caps text-2xl sm:text-3xl text-fairway">Off</span>
    </div>

    <!-- Fore | flagpole | Grant -->
    <div class="mt-1 flex items-end justify-center gap-2 sm:gap-4">
      <span class="font-script italic text-7xl sm:text-8xl lg:text-9xl text-fairway leading-none">
        Fore
      </span>
      <svg viewBox="0 0 70 120" class="h-20 sm:h-24 lg:h-28 w-auto shrink-0 -mb-1" aria-hidden="true">
        <!-- flagpole -->
        <line x1="35" y1="0" x2="35" y2="102" stroke="#2f4a34" stroke-width="5" stroke-linecap="round" />
        <!-- flag -->
        <path d="M35 2 L60 12 L35 22 Z" fill="#de6a3a" />
        <!-- putting green -->

        <path d="M4 106 C4 98, 22 94, 35 94 C52 94, 66 99, 66 106 C66 112, 50 116, 33 116 C16 116, 4 112, 4 106 Z" fill="#2f4a34" />
        <circle cx="22" cy="105" r="3.5" fill="#f2efe4" />
      </svg>
      <span class="font-script italic text-7xl sm:text-8xl lg:text-9xl text-fairway leading-none">
        Grant
      </span>
    </div>

    <!-- tagline, right-ish like the flyer, kept centered for web -->
    <p class="mt-4 font-display text-2xl sm:text-3xl font-bold text-fairway">
      His Fight Is Our Fight
    </p>

    <!-- ribbon banner hashtag -->
    <div class="mt-6 flex justify-center">
      <span class="ribbon-banner font-display text-lg sm:text-xl font-bold tracking-wide">
        #GrantsTALLBattle
      </span>
    </div>

    <!-- event details card -->
    <div class="mt-14 mx-auto max-w-2xl rounded-xl bg-paper-dim px-8 py-7">
      <p class="font-display text-xl sm:text-2xl font-bold text-ink">
        Friday, November 6<sup>th</sup>, 2026
      </p>
      <p class="mt-1 font-display font-semibold text-ink">
        9:00<sup class="text-xs">AM</sup> Shotgun Start
      </p>
      <p class="mt-2 font-display font-semibold text-ink">
        San Vicente Golf Course
        <span class="text-ribbon font-normal mx-1">|</span>
        <span class="font-medium">24157 San Vicente Rd – Ramona, CA 92065</span>
      </p>
    </div>

    <div class="mt-10">
      <a
        href="/contact"
        class="inline-block bg-ribbon px-10 py-3 font-display text-lg font-bold text-white shadow-sm transition hover:bg-ribbon-dark"
      >
        Register as a Sponsor
      </a>
    </div>


  </section>




  <!-- Meet Grant -->
  <section class="py-4">
    <div class="rounded-xl border-2 border-ribbon px-6 py-8 sm:px-10 sm:py-10 text-center">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-ribbon">
        Meet Grant: Join the Fight
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-ink-soft">
        Grant is a strong and inspiring 10-year-old who is bravely battling leukemia. This
        tournament is more than a game—it's a way to come together and rally around Grant and
        his family. By becoming a sponsor, you are helping provide hope, strength, and support
        when it's needed most.
      </p>
      <a href="/about" class="mt-5 inline-block font-medium text-fairway hover:text-ribbon">
        Read more about Grant's story &rarr;
      </a>
    </div>
  </section>

  <!-- Sponsorship tiers -->
  <section id="sponsor" class="py-16 lg:py-24 scroll-mt-8">
    <h2 class="text-center font-display text-3xl sm:text-4xl font-bold text-fairway">
      Sponsorship Opportunities
    </h2>
    <p class="mt-3 text-center text-ink-soft max-w-2xl mx-auto">
      Every sponsorship — big or small — helps drive out leukemia, one swing at a time.
      Register directly using the form below.
    </p>



    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        tiers.map((tier) => (
          <div
            class={`rounded-lg p-6 flex flex-col ${
              tier.featured
                ? "bg-fairway text-paper ring-2 ring-ribbon"
                : "bg-paper-dim text-ink"
            }`}
          >
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="font-display font-semibold text-lg">{tier.name}</h3>
              <span
                class={`shrink-0 text-xs font-medium rounded-full px-2 py-1 ${
                  tier.featured ? "bg-ribbon text-white" : "bg-fairway text-paper"
                }`}
              >
                {tier.max}
              </span>
            </div>
            <p
              class={`mt-1 font-display text-2xl font-bold ${
                tier.featured ? "text-ribbon-light" : "text-ribbon"
              }`}
            >
              {tier.price}
            </p>
            <ul class="mt-4 space-y-2 text-sm flex-1">
              {tier.perks.map((perk) => (
                <li class="flex gap-2">
                  <span class={tier.featured ? "text-ribbon-light" : "text-ribbon"}>▸</span>
                  <span class={tier.featured ? "text-paper/90" : "text-ink-soft"}>{perk}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-lg border-2 border-ribbon px-6 py-6 text-center">
      <h3 class="font-display text-xl font-bold text-ribbon">Other Ways to Support Us!</h3>
      <p class="mt-2 max-w-2xl mx-auto text-ink-soft text-sm">
        If a sponsorship isn't possible, please consider donating products, services, or gift
        certificates for our golf goodie bags, raffle, or silent auction. This event wouldn't be
        possible without the generous support of our donors. Your contribution makes a huge
        difference!
      </p>
    </div>

    <p class="mt-8 text-center text-ink-soft">
      Ready to register, or have a question first?
      <a href="/contact" class="font-medium text-fairway hover:text-ribbon">Register now</a>.
    </p>


  </section>
</BaseLayout>

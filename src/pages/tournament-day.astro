---
/**
 * Tournament Day — per LAYOUT-SPEC.md "Tournament Day — 1440×4354".
 *
 * Page header: col · pad 80/64/48/64 · gap 24.
 * Day-of: col · pad 0/64/106/64 → cards row, 1312×580, gap 24.
 * Schedule & Format: col · pad 45/64/80/64 → split row, gap 108, 2px divider.
 * Groups: col · pad 26/64/80/64 · gap 32 — lookup 1312×135, table 1312×1727.
 *
 * GAP: real pairings data doesn't exist yet — it comes from a Google Sheet
 * tab that hasn't been built (see roadmap Phase 6, HANDOFF.md §3). The
 * Figma sample names are explicitly placeholders per LAYOUT-SPEC.md
 * "Things that are logic, not layout" #4. Groups table renders a
 * "posted morning-of" empty state until that data source exists, rather
 * than shipping fake names.
 *
 * Mobile Groups ships collapsed — lookup → matched card → "View all 18
 * holes" disclosure. Not buildable without data; documented as deferred.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tournament Day — Teeing Off Fore Grant" navVariant="subpage">
  <section class="page-header">
    <h1>Tournament Day</h1>
  </section>

  <section class="day-of">
    <div class="day-of-cards">
      <div class="day-of-card">
        <img class="day-of-icon" src="/icons/icon-trophy.svg" width="44" height="44" alt="" aria-hidden="true" />
        <h2>Contests</h2>
        <ul class="day-of-list">
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Putting contest</strong>
              <span class="day-of-desc">Hosted at the putting green — sponsored by Putting for a Cure.</span>
            </span>
          </li>
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Longest Drive</strong>
              <span class="day-of-desc">Drive Out Leukemia contest hole.</span>
            </span>
          </li>
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Closest to the Pin</strong>
              <span class="day-of-desc">Swing for Strength contest hole.</span>
            </span>
          </li>
        </ul>
      </div>

      <div class="day-of-card">
        <img class="day-of-icon" src="/icons/icon-ticket.svg" width="44" height="44" alt="" aria-hidden="true" />
        <h2>Ways to Win</h2>
        <ul class="day-of-list">
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Silent auction</strong>
              <span class="day-of-desc">Bidding open through the round; winners announced at lunch.</span>
            </span>
          </li>
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Raffle</strong>
              <span class="day-of-desc">Tickets available at check-in and throughout the round.<br /><br />Raffle Ticket Prices<br />5 for $20&nbsp;&nbsp;|&nbsp;&nbsp;15 for $50&nbsp;&nbsp;|&nbsp;&nbsp;40 for $100<br /><br />50/50 Ticket Prices<br />1 for $5&nbsp;&nbsp;|&nbsp;&nbsp;25 for $100</span>
            </span>
          </li>
        </ul>
      </div>

      <div class="day-of-card">
        <img class="day-of-icon" src="/icons/icon-hamburger.svg" width="44" height="44" alt="" aria-hidden="true" />
        <h2>Meals</h2>
        <ul class="day-of-list">
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Breakfast</strong>
              <span class="day-of-desc">Opens at 7am — Breakfast Burritos</span>
            </span>
          </li>
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Lunch</strong>
              <span class="day-of-desc">Hot Dog and hamburger BBQ</span>
            </span>
          </li>
          <li>
            <span class="marker" aria-hidden="true">▸</span>
            <span class="day-of-copy">
              <strong class="day-of-label">Awards &amp; celebration</strong>
              <span class="day-of-desc">Held during lunch: awards, announcements, and thank yous.</span>
            </span>
          </li>
        </ul>
      </div>
    </div>

  <section class="schedule-format">
    <div class="schedule-format-split">
      <div class="schedule-format-col">
        <h2>Event Schedule</h2>
        <div class="schedule-block">
          <p class="schedule-sub">7:00 – 8:50 AM</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Check-in opens</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Silent auction opens for bidding</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Raffle tickets on sale</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Putting contest</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Breakfast served</span></li>
          </ul>
        </div>
        <div class="schedule-block">
          <p class="schedule-sub">8:50 AM</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Morning announcements</span></li>
          </ul>
        </div>
        <div class="schedule-block">
          <p class="schedule-sub">9:00 AM</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Shotgun start — all groups tee off together</span></li>
          </ul>
        </div>
        <div class="schedule-block">
          <p class="schedule-sub">After the round</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Lunch</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Awards</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Silent auction results</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Raffle drawing</span></li>
          </ul>
        </div>
      </div>

      <div class="schedule-format-divider" aria-hidden="true"></div>

      <div class="schedule-format-col">
        <h2>Tournament Format</h2>
        <div class="schedule-block">
          <p class="schedule-sub">Format</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Best ball — one score per foursome</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Play the best shot of the four each stroke</span></li>
          </ul>
        </div>
        <div class="schedule-block">
          <p class="schedule-sub">Start</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Shotgun start at 9:00 AM</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Your starting hole is listed in Groups below</span></li>
          </ul>
        </div>
        <div class="schedule-block">
          <p class="schedule-sub">Pace of play</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Ready golf — play when you are ready, not by honours</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Keep pace with the group ahead, not the group behind</span></li>
          </ul>
        </div>
        <div class="schedule-block">
          <p class="schedule-sub">Contests</p>
          <ul class="schedule-bullets">
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Longest Drive and Closest to the Pin on designated holes</span></li>
            <li><span class="schedule-marker" aria-hidden="true">▸</span><span>Putting contest runs before the shotgun start</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!--
    Groups: real pairings come from a Google Sheet tab that doesn't exist
    yet (roadmap Phase 6). Lookup + table are structurally ready per
    LAYOUT-SPEC (hole chip 48×48, A/B columns, zebra rows, name lookup
    highlight) but render a "posted morning-of" empty state until that
    data source is wired up — never shipping the Figma sample names.
  -->
  <section class="groups">
    <h2>Groups &amp; hole assignments</h2>

    <div class="groups-lookup">
      <label class="groups-lookup-label" for="group-lookup">Find your group</label>
      <input
        id="group-lookup"
        type="text"
        class="groups-lookup-input"
        placeholder="Type your name…"
        disabled
      />
      <p class="groups-lookup-hint">Groups are posted the morning of the tournament.</p>
    </div>

    <div class="groups-pending">
      <p>Hole assignments will be posted here on the morning of the tournament.</p>
    </div>
  </section>
</BaseLayout>


<style>
  /* Page header: col · pad 80/64/48/64 · gap 24 */
  .page-header {
    max-width: 1312px;
    margin: 0 auto;
    padding: var(--spacing-20) var(--spacing-16) var(--spacing-12);
    text-align: center;
  }
  .page-header h1 {
    font-family: var(--font-heading);
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    letter-spacing: var(--text-display-lg--letter-spacing);
    font-weight: 700;
    color: var(--color-text-brand);
  }

  /* Day-of: col · pad 0/64/106/64 → cards row, gap 24 */
  .day-of {
    background-color: var(--color-bg-page);
    padding: 0 var(--spacing-16) 106px;
  }
  .day-of-cards {
    max-width: 1312px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-6);
  }
  /* Cards hug vertically — never a fixed height (CLAUDE.md) */
  .day-of-card {
    background-color: var(--color-bg-panel);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    padding: var(--spacing-10);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .day-of-card h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-bucket);
    line-height: var(--text-heading-bucket--line-height);
    font-weight: 700;
    color: var(--color-text-brand);
    margin-bottom: var(--spacing-6);
    text-align: center;
  }
  .day-of-icon {
    margin-bottom: var(--spacing-4);
    color: var(--color-accent-default);
  }
  .day-of-list {
    display: flex; flex-direction: column; gap: var(--spacing-5);
    list-style: none; padding: 0; margin: 0; align-self: stretch;
  }
  .day-of-list li {
    display: flex; gap: var(--spacing-3);
    color: var(--color-text-primary);
  }
  .day-of-copy { display: flex; flex-direction: column; gap: var(--spacing-1); }
  .day-of-label {
    font-family: var(--font-heading);
    font-size: var(--text-heading-h3);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .day-of-desc {
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    color: var(--color-text-secondary);
  }
  .marker {
    font-family: var(--font-heading);
    font-size: var(--text-marker-md);
    font-weight: 700;
    color: var(--color-text-accent);
    flex-shrink: 0;
  }
</style>

<style>
  /* Schedule & Format: col · pad 45/64/80/64 → split row, gap 108 */
  .schedule-format {
    max-width: 1312px;
    margin: 0 auto;
    padding: 45px var(--spacing-16) var(--spacing-20);
  }
  .schedule-format-split {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 108px;
  }
  .schedule-format-divider {
    width: 2px;
    background-color: var(--color-accent-display);
  }
  .schedule-format-col h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    letter-spacing: var(--text-heading-section--letter-spacing);
    font-weight: 700;
    color: var(--color-text-brand);
    margin-bottom: var(--spacing-8);
  }
  .schedule-block { margin-bottom: var(--spacing-6); }
  .schedule-sub {
    font-family: var(--font-heading);
    font-size: var(--text-heading-h3);
    font-weight: 600;
    color: var(--color-text-accent);
    margin-bottom: var(--spacing-2);
  }
  .schedule-bullets {
    display: flex; flex-direction: column; gap: var(--spacing-2);
    list-style: none; padding: 0; margin: 0;
  }
  .schedule-bullets li {
    display: flex; gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    color: var(--color-text-primary);
  }
  .schedule-marker {
    font-family: var(--font-heading);
    font-size: var(--text-marker-sm);
    font-weight: 700;
    color: var(--color-brand-orange);
    flex-shrink: 0;
  }

  /* Groups: col · pad 26/64/80/64 · gap 32 */
  .groups {
    max-width: 1312px;
    margin: 0 auto;
    padding: 26px var(--spacing-16) var(--spacing-20);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }
  .groups h2 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: var(--text-heading-section--line-height);
    letter-spacing: var(--text-heading-section--letter-spacing);
    font-weight: 700;
    color: var(--color-text-brand);
  }

  /* Lookup: 1312×135 */
  .groups-lookup {
    background-color: var(--color-bg-panel);
    border-radius: var(--radius-lg);
    padding: var(--spacing-6) var(--spacing-8);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  .groups-lookup-label {
    font-family: var(--font-heading);
    font-size: var(--text-label-field);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .groups-lookup-input {
    height: var(--control-md);
    max-width: 400px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-control);
    background-color: var(--color-bg-field);
    padding: 0 var(--spacing-4);
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    color: var(--color-text-primary);
  }
  .groups-lookup-input:disabled {
    background-color: var(--color-state-disabled-bg);
    color: var(--color-state-disabled-text);
  }
  .groups-lookup-hint {
    font-family: var(--font-body);
    font-size: var(--text-body-xs);
    color: var(--color-text-secondary);
  }

  /* Pending state — table 1312×1727 replaced by this until real data exists */
  .groups-pending {
    background-color: var(--color-brand-subtle);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    padding: var(--spacing-12);
    text-align: center;
  }
  .groups-pending p {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .page-header { padding: var(--spacing-10) var(--spacing-5) var(--spacing-6); }
    .page-header h1 {
      font-size: var(--text-mobile-display-lg);
      line-height: var(--text-mobile-display-lg--line-height);
    }
    .day-of { padding: 0 var(--spacing-5) var(--spacing-10); }
    .day-of-cards { grid-template-columns: 1fr; }
    .schedule-format { padding: var(--spacing-6) var(--spacing-5) var(--spacing-10); }
    .schedule-format-split { grid-template-columns: 1fr; }
    .schedule-format-divider { display: none; }
    .schedule-format-col h2 {
      font-size: var(--text-mobile-heading-section);
      line-height: var(--text-mobile-heading-section--line-height);
    }
    .groups { padding: var(--spacing-6) var(--spacing-5) var(--spacing-10); }
    .groups h2 {
      font-size: var(--text-mobile-heading-section);
      line-height: var(--text-mobile-heading-section--line-height);
    }
    .marker {
      font-size: var(--text-mobile-marker-md);
      line-height: var(--text-mobile-marker-md--line-height);
    }
    .schedule-marker {
      font-size: var(--text-mobile-marker-sm);
      line-height: var(--text-mobile-marker-sm--line-height);
    }
  }
</style>


  </section>

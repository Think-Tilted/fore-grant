---
/**
 * Confirmation — NEW page, per LAYOUT-SPEC.md "Confirmation — 1440×2213"
 * and CLAUDE.md "Confirmation is a receipt, not a card" (2026-08-26,
 * supersedes BUILD-SPEC §8's earlier "Tier Row instance" language).
 *
 * The package block is a LIST WITH HAIRLINES — no card fill, no border,
 * no radius. PACKAGE / AMOUNT / ENTRY / PAYMENT as label-value lines in
 * mono/label, then an INCLUDED benefits list. Desktop: label+value one
 * line. Mobile (390): value stacks under its label.
 *
 * Payment is offline only — copy reflects "invoice follows, nothing
 * charged online" (CLAUDE.md "Confirmation email IS the invoice").
 * noindex per LAYOUT-SPEC "Things that are logic, not layout" #2 —
 * exposes personal payment/contact details.
 *
 * Not a nav destination — BaseLayout's nav carries no active state here.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { allTiers } from "../data/tiers";

// Tier data embedded as a JSON island — populated client-side by
// confirmation.js since this is a static page and Astro.url.searchParams
// is always empty at build time.
const tiersJson = JSON.stringify(allTiers);
---

<BaseLayout title="Registration Confirmed — Teeing Off Fore Grant" navVariant="subpage" noindex>
  <!-- JSON data island — confirmation.js reads this to populate the receipt.
       type="application/json" prevents the browser from executing it as JS
       while keeping the content unparsed (no HTML entity escaping). -->
  <script id="tier-data" type="application/json" set:html={tiersJson}></script>

  <!-- Page header: col · pad 80/0/40/0 · gap 24 · center -->
  <section class="confirm-header">
    <h1>You're registered.</h1>
  </section>

  <!-- Your package: col · pad 0/64/56/64 · gap 24 -->
  <section class="confirm-package">
    <h2 class="confirm-section-label">Your package</h2>
    <div class="receipt">
      <div class="receipt-row">
        <span class="receipt-label">PACKAGE</span>
        <span class="receipt-value" id="receipt-package">—</span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">AMOUNT</span>
        <span class="receipt-value receipt-value--price" id="receipt-amount">—</span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">ENTRY</span>
        <span class="receipt-value" id="receipt-entry">—</span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">PAYMENT</span>
        <span class="receipt-value">Invoice to follow — nothing charged online</span>
      </div>
    </div>

    <div class="receipt-included" id="receipt-included" hidden>
      <h3 class="receipt-included-label">INCLUDED</h3>
      <ul class="receipt-benefits" id="receipt-benefits"></ul>
    </div>
  </section>

  <!-- What happens next: col · pad 0/64/96/64 · gap 32, steps row 3-col -->
  <section class="confirm-next">
    <h2 class="confirm-section-label">What happens next</h2>
    <div class="next-steps">
      <div class="next-step">
        <span class="next-step-num">01</span>
        <h3>Check your inbox</h3>
        <p>A copy of your registration and an official invoice will come from Jess shortly!</p>
      </div>
      <div class="next-step">
        <span class="next-step-num">02</span>
        <h3>Send payment</h3>
        <p>Sooner is better. Friday, October 30 is the final deadline, and you can pay by Venmo, check or cash.</p>
      </div>
      <div class="next-step">
        <span class="next-step-num">03</span>
        <h3>See you on the 6th</h3>
        <p>Your tee time and starting hole go out closer to the day, and are posted on Tournament Day.</p>
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/confirmation.js"></script>
</BaseLayout>

<style>
  /* Page header: col · pad 80/0/40/0 · gap 24 · center */
  .confirm-header {
    padding: var(--spacing-20) 0 var(--spacing-10);
    text-align: center;
  }
  .confirm-header h1 {
    font-family: var(--font-heading);
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    letter-spacing: var(--text-display-lg--letter-spacing);
    font-weight: 700;
    color: var(--color-text-brand);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-display);
    text-underline-offset: 6px;
  }

  /* Your package: col · pad 0/64/56/64 · gap 24 */
  .confirm-package {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--spacing-16) 56px;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }
  /* Subheadings smaller than h1 for clear hierarchy — Kyle Row 12 */
  .confirm-section-label {
    font-family: var(--font-heading);
    font-size: var(--text-heading-bucket);
    line-height: var(--text-heading-bucket--line-height);
    font-weight: 700;
    color: var(--color-text-brand);
  }

  /* Receipt: list, no fill/border/radius, 1px hairlines between rows */
  .receipt { display: flex; flex-direction: column; }
  .receipt-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding: var(--spacing-3) 0;
    border-bottom: 1px solid var(--color-border-default);
  }
  .receipt-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    line-height: var(--text-mono-label--line-height);
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }
  .receipt-value {
    font-family: var(--font-body);
    font-size: var(--text-body-md-strong);
    font-weight: 600;
    color: var(--color-text-primary);
    text-align: right;
  }
  .receipt-value--price {
    font-family: var(--font-heading);
    font-size: var(--text-display-price);
    line-height: var(--text-display-price--line-height);
    font-weight: 700;
    color: var(--color-text-accent);
  }

  .receipt-included { margin-top: var(--spacing-4); }
  .receipt-included-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    line-height: var(--text-mono-label--line-height);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-3);
  }
  .receipt-benefits {
    display: flex; flex-direction: column; gap: var(--spacing-2);
    list-style: none; padding: 0; margin: 0;
  }
  .receipt-benefits li {
    display: flex; gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    line-height: var(--text-body-md--line-height);
    color: var(--color-text-primary);
  }
  .receipt-marker { color: var(--color-text-accent); flex-shrink: 0; }

  /* What happens next: col · pad 0/64/96/64 · gap 32, steps row 3-col */
  .confirm-next {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0 var(--spacing-16) var(--spacing-24);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }
  .next-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-8);
  }
  .next-step {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  .next-step-num {
    font-family: var(--font-heading);
    font-size: var(--text-heading-section);
    line-height: 1;
    font-weight: 700;
    color: var(--color-accent-display);
    margin-bottom: var(--spacing-2);
  }
  .next-step h3 {
    font-family: var(--font-heading);
    font-size: var(--text-heading-h3);
    line-height: var(--text-heading-h3--line-height);
    font-weight: 700;
    color: var(--color-text-brand);
  }
  .next-step p {
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    line-height: var(--text-body-md--line-height);
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .confirm-header { padding: var(--spacing-8) 0 var(--spacing-4); }
    .confirm-header h1 {
      font-size: var(--text-mobile-display-lg);
      line-height: var(--text-mobile-display-lg--line-height);
    }
    .confirm-package { padding: 0 var(--spacing-5) var(--spacing-8); gap: var(--spacing-4); }
    .confirm-next { padding: 0 var(--spacing-5) var(--spacing-10); gap: var(--spacing-5); }
    .next-steps { grid-template-columns: 1fr; gap: var(--spacing-5); }
    /* Value stacks under its label at 390 */
    .receipt-row { flex-direction: column; align-items: flex-start; gap: var(--spacing-1); }
    .receipt-value { text-align: left; }
    /* Price is too large at mobile — scale down */
    .receipt-value--price {
      font-size: var(--text-mobile-display-price);
      line-height: var(--text-mobile-display-price--line-height);
    }
    /* "Your package" label redundant on mobile — hidden */
    .confirm-package > .confirm-section-label { display: none; }
    /* h1 underline offset tighter on mobile */
    .confirm-header h1 {
      font-size: var(--text-mobile-display-lg);
      line-height: var(--text-mobile-display-lg--line-height);
      text-underline-offset: 4px;
    }
  }
</style>


---
/**
 * MobileMenu — per LAYOUT-SPEC.md "Menu — 390" and HANDOFF.md §6.
 *
 * Full-screen overlay, bg/inverse, 390×844 in Figma.
 * Nav bar 72px with X (Menu-Mobile variant). Rows: Home, Tournament Day,
 * Contact — separated by 1px accent/display hairlines. Register Today is
 * the orange button, not a row. X fires CLOSE → returns to underlying page.
 * Toggle and X are 44×44 hit targets.
 */
import Logo from "./Logo.astro";
import Button from "./Button.astro";
---

<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu" hidden>
  <!-- Top bar: logo + close -->
  <div class="mobile-menu-bar">
    <a href="/" class="mobile-menu-logo" aria-label="Teeing Off Fore Grant — home">
      <Logo variant="negative" />
    </a>
    <button
      type="button"
      class="mobile-menu-close"
      aria-label="Close menu"
      data-menu-close
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="6" y1="6" x2="18" y2="18" />
        <line x1="18" y1="6" x2="6" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Links -->
  <nav class="mobile-menu-links" aria-label="Mobile navigation">
    <a href="/" class="mobile-menu-link">Home</a>
    <span class="mobile-menu-rule" aria-hidden="true"></span>
    <a href="/tournament-day" class="mobile-menu-link">Tournament Day</a>
    <span class="mobile-menu-rule" aria-hidden="true"></span>
    <a href="/contact" class="mobile-menu-link">Contact</a>
  </nav>

  <!-- CTA -->
  <div class="mobile-menu-cta">
    <Button href="/registration" size="large" variant="primary">Register Today</Button>
  </div>
</div>

<script is:inline src="/scripts/mobile-menu.js"></script>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--color-bg-inverse);
    display: flex;
    flex-direction: column;
  }
  .mobile-menu[hidden] { display: none; }

  .mobile-menu-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    padding: 0 var(--spacing-5);
    flex-shrink: 0;
  }
  .mobile-menu-logo {
    height: 40px;
    width: auto;
  }
  .mobile-menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--color-text-inverse);
    cursor: pointer;
    padding: 0;
  }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-6);
    gap: 0;
  }
  .mobile-menu-link {
    font-family: var(--font-heading);
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--color-text-inverse);
    text-decoration: none;
    padding: var(--spacing-4) 0;
  }
  .mobile-menu-rule {
    height: 1px;
    background-color: var(--color-accent-display);
  }

  .mobile-menu-cta {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-2) var(--spacing-6) 0;
  }
</style>

---
/**
 * Footer — ported from Figma "Footer" component (design/ROADMAP.md
 * Phase 5.1).
 *
 * Figma source structure (design/figma-file.json, "Footer" page):
 *   - dark green (bg-inverse) full-width band with an argyle strip on top
 *   - tagline: "Together, we can drive out leukemia — one swing at a time."
 *   - 3-column body (divided by vertical rules):
 *       Get Connected — heading "Follow Us on Instagram" + a single
 *         Instagram handle row (icon + "@GrantsTALLBattle") + "Photos,
 *         pairings and day-of updates. Tag your round with
 *         #GrantsTALLBattle." — revised from the original 3-generic-icon
 *         layout (per design/ROADMAP.md's Footer note; confirmed directly
 *         against design/figma-file.json, not assumed)
 *       Questions — email + phone
 *       Pages — Registration / Tournament Day / Contact nav links
 *   - horizontal rule near the bottom (copyright line sits below it —
 *     Figma frame doesn't show literal copyright text, using the existing
 *     site's pattern)
 */
import ArgyleBand from "./ArgyleBand.astro";
import SocialIcon from "./SocialIcon.astro";
---

<footer class="footer">
  <ArgyleBand size="tall" />
  <div class="footer-body">
    <p class="footer-tagline">
      Together, we can drive out leukemia — one swing at a time.
    </p>

    <div class="footer-sections">
      <div class="footer-section">
        <h3 class="footer-heading">Follow Us on Instagram</h3>
        <div class="footer-handle">
          <SocialIcon href="https://instagram.com/GrantsTALLBattle" label="@GrantsTALLBattle on Instagram" />
          <a href="https://instagram.com/GrantsTALLBattle" class="footer-handle-text" target="_blank" rel="noopener noreferrer">
            @GrantsTALLBattle
          </a>
        </div>
        <p class="footer-text">
          Photos, pairings and day-of updates. Tag your round with #GrantsTALLBattle.
        </p>
      </div>


      <div class="footer-divider" aria-hidden="true"></div>

      <div class="footer-section">
        <h3 class="footer-heading">Questions</h3>
        <p class="footer-text">
          <a href="mailto:grantstallbattle@gmail.com" class="footer-link">grantstallbattle@gmail.com</a>
        </p>
        <p class="footer-text">
          <a href="tel:6193447687" class="footer-link">Jessica — 619-344-7687</a>
        </p>
      </div>

      <div class="footer-divider" aria-hidden="true"></div>

      <div class="footer-section">
        <h3 class="footer-heading">Pages</h3>
        <div class="footer-links">
          <a href="/registration" class="footer-link">Registration</a>
          <a href="/tournament-day" class="footer-link">Tournament Day</a>
          <a href="/contact" class="footer-link">Contact</a>
        </div>
      </div>
    </div>

    <hr class="footer-rule" />

    <p class="footer-copyright">
      &copy; {new Date().getFullYear()} Teeing Off Fore Grant
    </p>
  </div>
</footer>

<style>
  @layer components {
    .footer {
      background-color: var(--color-bg-inverse);
    }

    /* LAYOUT-SPEC: body pad 64/64/48/64 · gap 40 */
    .footer-body {
      max-width: 1312px;
      margin: 0 auto;
      padding: var(--spacing-16) var(--spacing-16) var(--spacing-12);
      display: flex;
      flex-direction: column;
      gap: var(--spacing-10);
    }

    /* CLAUDE.md: "Section headings are all 36px everywhere... the footer
       tagline." SemiBold, not Bold — --text-heading-section-soft. */
    .footer-tagline {
      font-family: var(--font-heading);
      font-size: var(--text-heading-section-soft);
      line-height: var(--text-heading-section-soft--line-height);
      font-weight: 600;
      color: var(--color-text-inverse);
      text-align: center;
    }

    .footer-sections {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: var(--spacing-8);
      align-items: start;
    }

    @media (max-width: 767px) {
      .footer-body {
        padding: var(--spacing-10) var(--spacing-5) var(--spacing-8);
      }
      .footer-sections {
        grid-template-columns: 1fr;
      }
      .footer-divider {
        display: none;
      }
    }

    /* CLAUDE.md "Orange as structure": 2px accent/display vertical dividers */
    .footer-divider {
      width: 2px;
      align-self: stretch;
      background-color: var(--color-accent-display);
    }

    /* Figma "h" nodes (Get Connected/Questions/Pages headings) — Bitter
       22px/700, ls -0.22px, bg-page color. Was previously 14px uppercase
       letterspaced with a different color — didn't match any of these
       section headings in the source file. */
    .footer-heading {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.22px;
      color: var(--color-bg-page);
      margin-bottom: var(--spacing-4);
    }

    /* "handle" frame — itemSpacing 12 between icon and text. */
    .footer-handle {
      display: flex;
      align-items: center;
      gap: var(--spacing-3);
      margin-bottom: var(--spacing-4);
    }
    /* "handle > handle" text node — Bitter 20px/600, ls 0.2px, bg-page. */
    .footer-handle-text {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0.2px;
      color: var(--color-bg-page);
      text-decoration: none;
    }
    .footer-handle-text:hover {
      color: var(--color-accent-display);
    }

    .footer-text {
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--color-text-inverse);
      margin-bottom: var(--spacing-2);
    }

    .footer-link {
      color: var(--color-text-inverse);
      text-decoration: none;
    }
    .footer-link:hover {
      color: var(--color-accent-display);
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-3);
    }

    .footer-rule {
      border: none;
      border-top: 1px solid var(--color-border-default);
    }

    .footer-copyright {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--color-text-inverse);
      text-align: center;
    }
  }
</style>

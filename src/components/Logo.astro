---
/**
 * Logo — per figma-handoff/assets/MANIFEST.md.
 *
 * The site uses exactly two logo assets:
 *   badge:    ForeGrant-Badge.svg — Home hero (520×378 per LAYOUT-SPEC)
 *   negative: ForeGrant-hor-Neg.svg — subpage nav bar (165×64 per LAYOUT-SPEC)
 */
export type LogoVariant = "badge" | "negative";

interface Props {
  variant?: LogoVariant;
  alt?: string;
  class?: string;
}

const { variant = "badge", alt = "Teeing Off Fore Grant", class: className = "" } = Astro.props;

const src = variant === "negative"
  ? "/logos/ForeGrant-hor-Neg.svg"
  : "/logos/ForeGrant-Badge.svg";
---

<img src={src} alt={alt} class:list={["logo", className]} />

<style>
  .logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

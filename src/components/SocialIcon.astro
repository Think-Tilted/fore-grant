---
/**
 * SocialIcon — ported from Figma "Social Icon" component set
 * (design/ROADMAP.md Phase 5.1, "Icon" page).
 *
 * Figma defines 3 variants (X, Facebook, Instagram) as 28×28 icon glyphs.
 * These are simple standard logo glyphs, not custom brand artwork — built
 * here as inline SVG using well-known public logo paths rather than going
 * through the Figma image-export step (see design/ROADMAP.md "Exporting
 * real assets from Figma" — that process is reserved for genuinely custom
 * artwork like the Fore Grant wordmark, not generic platform icons).
 */
export type SocialPlatform = "x" | "facebook" | "instagram";

interface Props {
  platform: SocialPlatform;
  href: string;
  label?: string;
  class?: string;
}

const { platform, href, label, class: className = "" } = Astro.props;

const labels: Record<SocialPlatform, string> = {
  x: "X (Twitter)",
  facebook: "Facebook",
  instagram: "Instagram",
};

const ariaLabel = label ?? labels[platform];
---

<a href={href} class:list={["social-icon", className]} aria-label={ariaLabel} target="_blank" rel="noopener noreferrer">
  {platform === "x" && (
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
  )}
  {platform === "facebook" && (
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.507 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.878h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94z" />
    </svg>
  )}
  {platform === "instagram" && (
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465a4.9 4.9 0 011.772 1.153 4.9 4.9 0 011.153 1.772c.248.637.416 1.363.465 2.428.05 1.066.06 1.405.06 4.122s-.01 3.056-.06 4.122c-.05 1.065-.217 1.79-.465 2.428a4.9 4.9 0 01-1.153 1.772 4.9 4.9 0 01-1.772 1.153c-.637.248-1.363.416-2.428.465-1.066.05-1.405.06-4.122.06s-3.056-.01-4.122-.06c-1.065-.05-1.79-.217-2.428-.465a4.9 4.9 0 01-1.772-1.153 4.9 4.9 0 01-1.153-1.772c-.248-.637-.416-1.363-.465-2.428C2.01 15.056 2 14.717 2 12s.01-3.056.06-4.122c.05-1.065.217-1.79.465-2.428A4.9 4.9 0 013.678 3.678a4.9 4.9 0 011.772-1.153c.637-.248 1.363-.416 2.428-.465C8.944 2.01 9.283 2 12 2zm0 1.802c-2.67 0-2.986.01-4.04.059-.976.045-1.505.207-1.858.344-.467.182-.8.399-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.05 1.055-.06 1.372-.06 4.04s.01 2.986.06 4.04c.045.976.207 1.505.344 1.858.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.05 1.37.06 4.041.06s2.987-.01 4.041-.06c.976-.045 1.505-.207 1.858-.344.466-.182.8-.399 1.15-.748.35-.35.566-.684.748-1.15.137-.353.3-.882.344-1.857.05-1.055.06-1.372.06-4.041s-.01-2.987-.06-4.041c-.045-.976-.207-1.505-.344-1.858a3.1 3.1 0 00-.748-1.15 3.1 3.1 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.055-.05-1.372-.06-4.041-.06zm0 3.064a5.134 5.134 0 110 10.268 5.134 5.134 0 010-10.268zm0 8.468a3.334 3.334 0 100-6.668 3.334 3.334 0 000 6.668zm6.538-8.671a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z" />
    </svg>
  )}
</a>

<style>
  @layer components {
    .social-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      color: var(--color-text-inverse);
      transition: color 0.15s ease;
    }
    .social-icon:hover {
      color: var(--color-accent-display);
    }
  }
</style>

---
/**
 * SocialIcon — Instagram only per CLAUDE.md ("the only social account;
 * footer is IG-only"). 28×28 inline SVG.
 */
interface Props {
  href: string;
  label?: string;
  class?: string;
}

const { href, label = "Instagram", class: className = "" } = Astro.props;
---


  </svg>
</a>

<style>
  @layer components {
    .social-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      color: var(--color-text-inverse);
      transition: color 0.15s ease;
    }
    .social-icon:hover {
      color: var(--color-accent-display);
    }
  }

---
/**
 * Badge — ported from Figma "Badge" component set
 * (design/ROADMAP.md Phase 5.1).
 *
 * Figma source values (design/figma-file.json, "Badge" page):
 *   Shape: pill (radius-full), padding 16px/8px, font-size 14px, semibold
 *
 * NOTE: the Figma source had Tone=SoldOut and Tone=Neutral (Reversed=False)
 * with IDENTICAL fill/text colors (brand-green @8%, black text) — flagged
 * as a likely oversight. Confirmed with the client (2026-09-02): sold-out
 * should read as a true, unambiguous red — distinct from --color-brand-rust
 * (already used for "limited" text and CTA hover) so it can't be mistaken
 * for an interactive/CTA color. tokens.css is intentionally a closed
 * 6-color palette ("no new hues") — rather than add a global 7th color for
 * this one state, --badge-soldout-red is scoped locally to this component.
 */


export type BadgeTone = "neutral" | "limited" | "soldout" | "featured";

interface Props {
  tone?: BadgeTone;
  reversed?: boolean;
  class?: string;
}

const { tone = "neutral", reversed = false, class: className = "" } = Astro.props;

const toneClass = `badge-${tone}${reversed ? "-reversed" : ""}`;
---

<span class:list={["badge", toneClass, className]}>
  <slot />
</span>

<style>
  @layer components {
    .badge {
      /* Scoped locally — see NOTE at top of file. True red, distinct from
         --color-brand-rust (orange-family, used for CTA hover/limited-text)
         so a sold-out badge can never be mistaken for an interactive color. */
      --badge-soldout-red: #B3261E;
      display: inline-flex;
      align-items: center;

      padding: var(--spacing-2) var(--spacing-4);
      border-radius: var(--radius-full);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: var(--text-label-badge);
      line-height: 1;
      white-space: nowrap;
    }

    @media (max-width: 767px) {
      .badge { font-size: var(--text-mobile-label-badge); }
    }

    /* ---- Neutral ---- */
    .badge-neutral {
      background-color: var(--color-brand-subtle);
      color: var(--color-text-primary);
    }
    .badge-neutral-reversed {
      background-color: var(--color-brand-light);
      color: var(--color-text-brand);
    }

    /* ---- Limited ---- */
    .badge-limited {
      background-color: var(--color-accent-subtle);
      color: var(--color-state-limited);
    }
    .badge-limited-reversed {
      background-color: var(--color-accent-default);
      color: var(--color-text-on-accent);
    }

    /* ---- SoldOut ---- */
    /* See NOTE above — solid red fill, distinct from neutral/limited. */
    .badge-soldout {
      background-color: var(--badge-soldout-red);
      color: var(--color-text-on-accent);
    }
    .badge-soldout-reversed {
      background-color: var(--color-base-white);
      color: var(--badge-soldout-red);
    }


    /* ---- Featured ---- */
    .badge-featured,
    .badge-featured-reversed {
      background-color: var(--color-accent-default);
      color: var(--color-text-on-accent);
    }
  }
</style>

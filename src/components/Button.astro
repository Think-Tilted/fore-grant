---
/**
 * Button — ported from Figma "Button" component set
 * (design/ROADMAP.md Phase 5.1). Variant/Size axes are rendered via CSS
 * classes; State (Hover/Active/Focus/Disabled) is handled by native
 * pseudo-classes + the `disabled` attribute rather than separate markup,
 * since a real <button> already gets those states for free.
 *
 * Figma source values (design/figma-file.json, "Button" page):
 *   Medium: height 44px, padding-x 24px, font-size 16px
 *   Large:  height 52px, padding-x 32px, font-size 18px
 *   Both:   radius 8px (radius-md), gap 8px, font-weight 600 (Bitter)
 *
 *   Primary:   bg accent-default (#CD4628) -> hover accent-hover (#A53422)
 *              -> active accent-active (#8B2C1D), text white
 *   Secondary: transparent bg, border-control text-brand -> hover fills
 *              brand-default with white text -> active same fill, darker text
 *   Ghost:     transparent, text-brand -> hover brand-subtle bg -> active
 *              darker text, no border ever
 *   Disabled:  Primary/Secondary use state-disabled-bg fill (or border),
 *              Ghost has no fill/border at all — all use
 *              state-disabled-text for the label
 *   Focus:     border-focus (accent-default orange) ring, handled here via
 *              :focus-visible outline rather than a separate variant
 */
interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "medium" | "large";
  href?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "medium",
  href,
  type = "button",
  disabled = false,
  class: className = "",
} = Astro.props;

const sizeClass = size === "large" ? "btn-lg" : "btn-md";
const variantClass = `btn-${variant}`;
const Tag = href ? "a" : "button";
---

<Tag
  class:list={["btn", variantClass, sizeClass, className]}
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  aria-disabled={disabled ? "true" : undefined}
>
  <slot />
</Tag>

<style>
  @layer components {
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-2);
      border-radius: var(--radius-md);
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: 0.02em;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background-color var(--motion-duration-hover) var(--motion-ease),
                  color var(--motion-duration-hover) var(--motion-ease),
                  border-color var(--motion-duration-hover) var(--motion-ease),
                  transform var(--motion-duration-hover) var(--motion-ease);
    }

    .btn-md {
      height: var(--control-md);
      padding: 0 var(--spacing-6);
      font-size: 16px;
    }

    .btn-lg {
      height: var(--control-lg);
      padding: 0 var(--spacing-8);
      font-size: 18px;
    }

    /* ---- Primary ---- */
    .btn-primary {
      background-color: var(--color-accent-default);
      color: var(--color-text-on-accent);
    }
    .btn-primary:hover:not(:disabled) {
      background-color: var(--color-accent-hover);
      transform: translateY(var(--motion-lift));
    }
    .btn-primary:active:not(:disabled) {
      background-color: var(--color-accent-active);
      transform: scale(var(--motion-scale-press));
    }
    .btn-primary:disabled,
    .btn-primary[aria-disabled="true"] {
      background-color: var(--color-state-disabled-bg);
      color: var(--color-state-disabled-text);
      cursor: not-allowed;
      transform: none;
    }

    /* ---- Secondary ---- */
    .btn-secondary {
      background-color: transparent;
      border-color: var(--color-border-control);
      color: var(--color-text-brand);
    }
    .btn-secondary:hover:not(:disabled) {
      background-color: var(--color-brand-default);
      border-color: var(--color-brand-default);
      color: var(--color-text-brand);
    }
    .btn-secondary:active:not(:disabled) {
      background-color: var(--color-brand-default);
      border-color: var(--color-brand-default);
      color: var(--color-text-on-brand);
    }
    .btn-secondary:disabled,
    .btn-secondary[aria-disabled="true"] {
      border-color: var(--color-state-disabled-bg);
      color: var(--color-state-disabled-text);
      cursor: not-allowed;
    }

    /* ---- Ghost ---- */
    .btn-ghost {
      background-color: transparent;
      color: var(--color-text-brand);
    }
    .btn-ghost:hover:not(:disabled) {
      background-color: var(--color-brand-subtle);
    }
    .btn-ghost:active:not(:disabled) {
      background-color: var(--color-brand-subtle);
      color: var(--color-brand-active);
    }
    .btn-ghost:disabled,
    .btn-ghost[aria-disabled="true"] {
      color: var(--color-state-disabled-text);
      cursor: not-allowed;
    }

    /* ---- Focus (all variants) ---- */
    .btn:focus-visible {
      outline: 2px solid var(--color-border-focus);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      .btn { transition: none; transform: none; }
    }
  }
</style>

---
/**
 * NavLink — per figma-handoff/components.css nav-link spec + CLAUDE.md.
 *
 * Bitter 16px/600, letter-spacing 0.03em. Underline: 4px solid transparent
 * at rest (reserves space, no reflow). Hover shows 2px orange, active
 * shows 4px orange. The yield behavior (current page underline drops
 * when hovering a different item) is handled by the global rule in
 * components.css: `.nav:hover .nav-link[aria-current="page"]:not(:hover)`.
 *
 * Tone=Light: text-brand at rest, text-accent on hover/active.
 * Tone=Dark:  text-inverse at rest, bg-page on hover/active.
 */
interface Props {
  href: string;
  tone?: "light" | "dark";
  active?: boolean;
  class?: string;
}

const { href, tone = "light", active = false, class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={["nav-link", `nav-link--${tone}`, className]}
  aria-current={active ? "page" : undefined}
>
  <slot />
</a>

<style>
  .nav-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    padding: var(--spacing-2);
    border-bottom: 4px solid transparent;
    transition: border-color var(--motion-duration-hover) var(--motion-ease),
                color var(--motion-duration-hover) var(--motion-ease);
  }
  .nav-link:hover {
    border-bottom-color: var(--color-accent-display);
    border-bottom-width: 2px;
  }
  .nav-link[aria-current="page"] {
    border-bottom-color: var(--color-accent-display);
    border-bottom-width: 4px;
  }

  /* Tone=Light (Home hero, light bg) */
  .nav-link--light { color: var(--color-text-brand); }
  .nav-link--light:hover,
  .nav-link--light[aria-current="page"] { color: var(--color-text-accent); }

  /* Tone=Dark (subpage bar, green bg) */
  .nav-link--dark { color: var(--color-text-inverse); }
  .nav-link--dark:hover,
  .nav-link--dark[aria-current="page"] { color: var(--color-bg-page); }
</style>

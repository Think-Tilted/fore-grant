---
/**
 * ArgyleBand — per src/styles/argyle.css (regenerated 2026-08-27 from
 * Figma export, node 32:14).
 *
 * Three variants: full (with orange dots), plain (no dots),
 * mono (single green, no dots). Three sizes: tall (88px, every page
 * header and footer), standard (48px), trim (24px — pair with plain
 * since dots fall under 1px below 48px and read as mud).
 *
 * Tile is 84.6866×88px. background-size: auto 100% + repeat-x scales
 * to any band height and crops at narrow widths — NEVER squash.
 */
export type ArgyleSize = "tall" | "standard" | "trim";
export type ArgyleVariant = "full" | "plain" | "mono";

interface Props {
  size?: ArgyleSize;
  variant?: ArgyleVariant;
  class?: string;
}

const { size = "tall", variant = "full", class: className = "" } = Astro.props;
---

<div
  class:list={["argyle-band", `argyle-band--${size}`, `argyle--${variant}`, className]}
  aria-hidden="true"
></div>

<style>
  .argyle-band {
    background-color: var(--color-bg-page);
    background-repeat: repeat-x;
    background-position: center;
    background-size: auto 100%;
  }
  .argyle-band--tall     { height: 88px; }
  .argyle-band--standard { height: 48px; }
  .argyle-band--trim     { height: 24px; }
</style>

---
/**
 * ArgyleBand — per figma-handoff/assets/argyle.css + design-brief.md.
 *
 * Three variants: full (with crosshatch dots), plain (no crosshatch),
 * mono (single color). Two sizes: tall (88px, header band) and trim
 * (24px, email/tight spaces — pair with plain variant since dots fall
 * under 1px below 48px and read as mud).
 *
 * The tile is 46.9×48.735px (one dark + one olive diamond, point to
 * point). background-size: auto 100% + repeat-x scales to any band
 * height and crops at narrow widths — NEVER squash. The background
 * images are the handoff's exact SVG data URIs from argyle.css.
 */
export type ArgyleSize = "tall" | "trim";
export type ArgyleVariant = "full" | "plain" | "mono";

interface Props {
  size?: ArgyleSize;
  variant?: ArgyleVariant;
  class?: string;
}

const { size = "tall", variant = "full", class: className = "" } = Astro.props;
---

<div
  class:list={["argyle-band", `argyle-band--${size}`, `argyle--${variant}`, className]}
  aria-hidden="true"
></div>

<style>
  .argyle-band {
    background-color: var(--color-bg-page);
    background-repeat: repeat-x;
    background-position: center;
    background-size: auto 100%;
  }
  .argyle-band--tall { height: 88px; }
  .argyle-band--trim { height: 24px; }
</style>

---
/**
 * TierRow — per figma-handoff components.css + BUILD-SPEC.md §5c.
 *
 * Every row looks the SAME at rest. Featured is marked by its orange
 * edge alone. Hover turns the row dark green with light text.
 *
 * Mobile (<768): accordion. Ships collapsed. Rows open independently.
 * Sold out never expands and carries no chevron.
 * Height animates grid-template-rows: 0fr → 1fr.
 *
 * Desktop (≥768): always open, toggle is inert, chevron hidden.
 *
 * Markup follows components.css verbatim for ARIA compliance (class names,
 * aria-expanded/aria-controls, data-open). The DESKTOP INTERIOR LAYOUT is a
 * documented deviation from the components.css reference markup's simple
 * top-to-bottom flow — see DEVIATIONS.md "Tier row desktop layout" for the
 * reasoning (matches the Figma visual: left column name+benefits, right
 * column price+includes+badge+CTA). Mobile collapses back to a single
 * column per the accordion spec, where the two-column split doesn't apply.
 */
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import type { Tier } from "../data/tiers";
import { badgeTone, badgeLabel } from "../data/tiers";

export interface Props {
  tier: Tier;
  registerHref: string;
  class?: string;
}

const { tier, registerHref, class: className = "" } = Astro.props;
// Static fallback render — overridden live by public/scripts/availability.js
// once it fetches real counts from /api/availability. See tiers.ts header.
const remaining = tier.soldOut ? 0 : tier.capacity;
const tone = badgeTone(remaining);
const label = badgeLabel(remaining);
const panelId = `tier-${tier.id}`;
---

<article
  class:list={[
    "tier-row",
    { "tier-row--featured": tier.featured },
    { "tier-row--soldout": tier.soldOut },
    className,
  ]}
  data-open="false"
  data-tier-id={tier.id}
  data-capacity={tier.capacity}
>

  <div class="tier-row__grid">
    <!-- Left column: name/badge header → benefits panel -->
    <div class="tier-row__left">
      <h3 class="tier-row__header">
        <button
          class="tier-row__toggle"
          aria-expanded="false"
          aria-controls={panelId}
          disabled={tier.soldOut}
        >
          <span class="tier-row__name">{tier.name}</span>
          <Badge tone={tone} class="tier-row__badge">{label}</Badge>
          {!tier.soldOut && (
            <svg class="tier-row__chevron" aria-hidden="true" focusable="false"
              width="20" height="20" viewBox="0 0 20 20" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <polyline points="5 8 10 13 15 8" />
            </svg>
          )}
        </button>
      </h3>

      <div class="tier-row__panel" id={panelId} role="region"
        aria-label={`${tier.name} details`}>
        <div>
          <ul class="tier-row__benefits">
            {tier.benefits.map((b: string) => (
              <li class="tier-row__benefit">
                <span class="tier-row__marker" aria-hidden="true">▸</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Right column: price → CTA, stacked -->
    <div class="tier-row__right">
      <p class="tier-row__price">
        <span class="tier-row__money">
          {tier.price}
        </span>
        <span class="tier-row__includes">{tier.includes}</span>
        <Badge tone={tone} class="tier-row__badge-mobile">{label}</Badge>
      </p>

      <div class="tier-row__cta">
        {tier.soldOut ? (
          <Button variant="primary" size="medium" disabled>Sold Out</Button>
        ) : (
          <Button variant="primary" size="medium" href={registerHref}>
            Register Now
          </Button>
        )}
      </div>
    </div>
  </div>
</article>

<script is:inline src="/scripts/tier-row.js"></script>

<style>
  /* Row interior — components.css defines behavior/hover but leaves visual
     styling to page-level CSS per BUILD-SPEC §3 ("build with Tailwind
     utilities + our tokens"). LAYOUT-SPEC: desktop 1312 wide, 310 tall at
     rest, always expanded. Mobile: collapsed 142, expanded ~425.

     DEVIATION (see DEVIATIONS.md "Tier row desktop layout"): desktop splits
     into two columns — left: name+badge header, then benefits; right:
     price+includes, then CTA — matching the Figma visual rather than the
     single top-to-bottom flow in the components.css reference markup.
     Mobile reverts to a single column (the two-column split doesn't apply
     to the collapsed/accordion state). */
  .tier-row {
    padding: var(--spacing-8);
  }
  /* Desktop layout: flex row — left column (name + benefits) grows,
     right column (price + CTA) is fixed width and stacks independently.
     Using flex instead of grid avoids row-height cross-contamination:
     the price column's 58px never inflates the name row on the left. */
  .tier-row__grid {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-8);
  }
  .tier-row__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    min-width: 0;
  }
  .tier-row__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--spacing-3);
    flex-shrink: 0;
  }
  /* Keep grid alias classes pointing at the new structure */
  .tier-row__header { margin: 0; }
  .tier-row__price  { text-align: right; }
  .tier-row__panel  { width: 100%; }
  .tier-row__cta    {}

  .tier-row__toggle {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--spacing-3);
    width: 100%;
  }
  /* Chevron pushes to the far right via margin-left: auto;
     the global components.css uses justify-content: space-between which
     would push the badge right on desktop (chevron hidden). Override to
     flex-start keeps badge immediately after the name. */
  .tier-row__chevron {
    margin-left: auto;
    flex-shrink: 0;
  }

  /* Name: heading/tier (22px Bitter Bold) — shrinks so badge stays visible */
  .tier-row__name {
    font-family: var(--font-heading);
    font-size: var(--text-heading-tier);
    line-height: var(--text-heading-tier--line-height);
    font-weight: 700;
    color: var(--color-text-brand);
    flex-shrink: 1;
    min-width: 0;
  }
  /* Badge in toggle: visible on desktop only */
  :global(.tier-row__badge) {
    flex-shrink: 0;
  }
  /* Badge in price row: hidden on desktop, shown on mobile aligned right */
  :global(.tier-row__badge-mobile) {
    display: none;
    flex-shrink: 0;
    margin-left: auto;
  }
  /* Hover color overrides — scoped to hover-capable devices only.
     On touch screens :hover sticks after a tap, making rows look
     permanently selected. @media (hover: hover) excludes touchscreens. */
  @media (hover: hover) {
    .tier-row:hover .tier-row__name {
      color: var(--color-text-inverse);
    }
    .tier-row:hover .tier-row__money {
      color: var(--color-bg-page);
    }
    .tier-row:hover .tier-row__includes {
      color: var(--color-text-inverse);
    }
    .tier-row:hover .tier-row__benefit {
      color: var(--color-text-inverse);
    }
  }

  /* Mobile expanded state — same green language as desktop hover. */
  @media (max-width: 767px) {
    .tier-row[data-open="true"] .tier-row__name {
      color: var(--color-text-inverse);
    }
    .tier-row[data-open="true"] .tier-row__money {
      color: var(--color-bg-page);
    }
    .tier-row[data-open="true"] .tier-row__includes {
      color: var(--color-text-inverse);
    }
    .tier-row[data-open="true"] .tier-row__benefit {
      color: var(--color-text-inverse);
    }
  }

  /* Price column: price (display/price, 40px) right-aligned, includes + badge below */
  .tier-row__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    text-align: right;
    gap: var(--spacing-1);
  }
  .tier-row__money {
    font-family: var(--font-heading);
    font-size: var(--text-display-price);
    line-height: var(--text-display-price--line-height);
    font-weight: 700;
    color: var(--color-text-accent);
    white-space: nowrap;
  }
  .tier-row__includes {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  /* Benefits list */
  .tier-row__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  .tier-row__benefit {
    display: flex;
    gap: var(--spacing-2);
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    line-height: var(--text-body-md--line-height);
    color: var(--color-text-primary);
  }
  .tier-row__marker {
    font-family: var(--font-heading);
    font-size: var(--text-marker-sm);
    line-height: var(--text-marker-sm--line-height);
    font-weight: 700;
    color: var(--color-text-accent);
    flex-shrink: 0;
  }

  /* Panel: benefits then CTA below, stacked. Price floats in the right
     grid column spanning both rows. */
  .tier-row__panel > div {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }
  /* CTA button: justify centered */
  .tier-row__cta :global(.btn) {
    justify-content: center;
  }

  /* Badge inversion on hover and mobile open state — reversed tones on green bg */
  @media (hover: hover) {
    .tier-row:hover :global(.tier-row__badge) {
      background-color: var(--color-bg-page);
      color: var(--color-text-brand);
    }
  }
  @media (max-width: 767px) {
    .tier-row[data-open="true"] :global(.tier-row__badge-mobile) {
      background-color: var(--color-bg-page);
      color: var(--color-text-brand);
    }
  }

  @media (max-width: 767px) {
    .tier-row { padding: var(--spacing-4) var(--spacing-4) var(--spacing-3); }
    .tier-row__grid {
      grid-template-columns: 1fr;
    }
    /* Toggle badge hidden on mobile — price-row badge takes over */
    :global(.tier-row__badge) { display: none; }
    :global(.tier-row__badge-mobile) { display: inline-flex; }

    /* Mobile: flex column — left (header+panel) then right (price+CTA) stack */
    .tier-row__grid { flex-direction: column; gap: 0; }
    .tier-row__left { gap: 0; }
    .tier-row__right {
      width: 100%;
      align-items: flex-start;
      gap: var(--spacing-2);
    }
    .tier-row__price {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: var(--spacing-2);
      text-align: left;
    }
    /* CTA full width on mobile */
    .tier-row__cta { display: block; width: 100%; }
    .tier-row__cta :global(.btn) { display: flex; width: 100%; box-sizing: border-box; }
    /* Hide only the panel (benefits) and CTA when collapsed — price stays visible */
    .tier-row[data-open="false"] .tier-row__cta { display: none; }
    .tier-row__name {
      font-size: var(--text-mobile-heading-tier);
      line-height: var(--text-mobile-heading-tier--line-height);
    }
    .tier-row__money {
      font-size: var(--text-mobile-display-price);
      line-height: var(--text-mobile-display-price--line-height);
    }
    .tier-row__benefit {
      font-size: var(--text-mobile-body-sm);
      line-height: var(--text-mobile-body-sm--line-height);
    }
    .tier-row__marker {
      font-size: var(--text-mobile-marker-sm);
      line-height: var(--text-mobile-marker-sm--line-height);
    }
  }
</style>

---
/**
 * Nav — per figma-handoff LAYOUT-SPEC.md, BUILD-SPEC.md §2, CLAUDE.md.
 *
 * Desktop:
 *   Home:    light bg, centered badge logo (520×378), links below, gap 40.
 *            LAYOUT-SPEC: col · pad 48/0/40/0 · gap 32 · center.
 *   Subpage: 100px dark green bar, hor-neg logo (165×64) left, links right.
 *            LAYOUT-SPEC: row · pad 12/40/12/40 · space-between.
 *
 * Mobile (<768): ONE 72px dark bar on every page, hamburger right.
 *   Home hides the bar's logo (badge sits directly below).
 *   Hamburger opens MobileMenu overlay.
 *
 * On Registration: Register button becomes plain Home link, nothing active.
 */
import NavLink from "./NavLink.astro";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

export interface Props {
  variant?: "home" | "subpage";
  currentPath?: string;
}

const { variant = "home", currentPath = "" } = Astro.props;
// Normalize trailing slash so /tournament-day/ matches /tournament-day
const path = currentPath.replace(/\/$/, "") || "/";
const isRegistration = path === "/registration" ||
                       path.startsWith("/registration/");
---

<header class:list={["nav", `nav-${variant}`]}>
  <!-- Desktop nav -->
  <div class="nav-desktop">
    {variant === "home" ? (
      <div class="nav-home-inner">
        <a href="/" class="nav-home-logo" aria-label="Teeing Off Fore Grant — home">
          <Logo variant="badge" />
        </a>
        <nav class="nav-yield nav-home-links" aria-label="Primary">
          <Button href="/registration" size="medium">Register Today</Button>
          <NavLink href="/tournament-day" tone="light" active={path === "/tournament-day"}>
            Tournament Day
          </NavLink>
          <NavLink href="/contact" tone="light" active={path === "/contact"}>
            Contact
          </NavLink>
        </nav>
      </div>
    ) : (
      <div class="nav-sub-inner">
        <a href="/" class="nav-sub-logo" aria-label="Teeing Off Fore Grant — home">
          <Logo variant="negative" />
        </a>
        <nav class="nav-yield nav--dark nav-sub-links" aria-label="Primary">
          {isRegistration ? (
            <NavLink href="/" tone="dark">Home</NavLink>
          ) : (
            <Button href="/registration" size="medium">Register Today</Button>
          )}
          <NavLink href="/tournament-day" tone="dark"
            active={!isRegistration && path === "/tournament-day"}>
            Tournament Day
          </NavLink>
          <NavLink href="/contact" tone="dark"
            active={!isRegistration && path === "/contact"}>
            Contact
          </NavLink>
        </nav>
      </div>
    )}
  </div>

  <!-- Mobile nav bar (all pages, <768 only) -->
  <div class="nav-mobile">
    <a href="/" class="nav-mobile-logo" aria-label="Teeing Off Fore Grant — home">
      <Logo variant="negative" />
    </a>
    <button
      type="button"
      class="nav-hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>
</header>

<style>
  .nav { width: 100%; }
  .nav-desktop { display: block; }
  .nav-mobile { display: none; }

  /* Nav underline yield — components.css defines the global rule against
     `.nav`, which we can't reuse here without inheriting its width: 100%
     (that's what stretched the home links row and broke centering).
     Mirror the same behavior scoped to nav-yield instead. */
  :global(.nav-yield:hover .nav-link[aria-current="page"]:not(:hover)) {
    border-bottom-color: transparent;
  }

  /* Home hero: col · pad 48/0/40/0 · gap 32 · center */
  .nav-home .nav-desktop {
    background-color: var(--color-bg-page);
  }
  .nav-home-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-12) 0 var(--spacing-10);
    gap: var(--spacing-8);
  }
  .nav-home-logo {
    width: 520px;
    max-width: 80vw;
  }
  .nav-home-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-10);
  }

  /* Subpage bar: row · pad 12/40/12/40 · space-between, 100px tall */
  .nav-subpage .nav-desktop {
    background-color: var(--color-bg-inverse);
    height: 100px;
    display: flex;
    align-items: center;
  }
  .nav-sub-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--spacing-3) var(--spacing-10);
  }
  .nav-sub-logo {
    width: 165px;
    height: 64px;
    flex-shrink: 0;
  }
  .nav-sub-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
  }

  /* Mobile nav bar (<768) */
  @media (max-width: 767px) {
    .nav-desktop,
    .nav-subpage .nav-desktop,
    .nav-home .nav-desktop { display: none; }
    .nav-mobile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
      background-color: var(--color-bg-inverse);
      padding: 0 var(--spacing-5);
    }
    .nav-mobile-logo {
      height: 40px;
      width: auto;
    }
    .nav-hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      background: none;
      border: none;
      color: var(--color-text-inverse);
      cursor: pointer;
      padding: 0;
    }
  }
</style>


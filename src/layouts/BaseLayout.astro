---
/**
 * BaseLayout — shared page shell, rebuilt against the Figma design system
 * (design/ROADMAP.md Phase 5.3). Every Figma page frame (Home, Registration,
 * Register Form, Tournament Day, Contact) starts with the same structure:
 * an 88px-tall Argyle Band ("header band"), then Nav (Home or Subpage
 * variant), then page content, then Footer — so that shell lives here once
 * rather than being repeated per page.
 *
 * Global CSS is imported here in the frontmatter (not in a <style> tag) so
 * that Astro/Vite processes it as a true global stylesheet. Astro <style>
 * tags are always component-scoped — using one for global CSS causes the
 * scoping transform to fight @layer declarations and background-image rules.
 * Frontmatter import bypasses scoping entirely, which is the correct pattern
 * per the Astro + Tailwind v4 integration docs.
 */
import "../styles/global.css";
import ArgyleBand from "../components/ArgyleBand.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  navVariant?: "home" | "subpage";
}

const {
  title,
  description = "Teeing Off Fore Grant — a charity golf tournament supporting Grant's fight against leukemia. #GrantsTALLBattle",
  navVariant = "subpage",
} = Astro.props;
const siteBase = Astro.site ?? import.meta.env.PUBLIC_SITE_URL ?? "http://localhost:4321";
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Fonts per the Figma design system (design/ROADMAP.md): Bitter for
      display/headings/labels/buttons, Source Serif 4 for body copy.
      Weights requested cover the type scale's documented styles (regular,
      semibold, bold, plus bold italic for display/italic).
    -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ArgyleBand size="tall" />
    <Nav variant={navVariant} currentPath={currentPath} />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
